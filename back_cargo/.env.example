DATABASE_URL=postgres://ops_hub:ops_hub@localhost:5433/ops_hub
PORT=8082
DB_MAX_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=5
RUN_LOCK_KEY=8421337
RUST_LOG=info,sqlx=warn,tower_http=info
LOG_FORMAT=pretty

# Neon の検証が必要な場合も、実値は .env.example や Git 履歴へ保存しない。
NEON_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# プロジェクト       PostgreSQL   API
# shisan-api         5432         8080
# ops-hub            5433         8081
# chess              5434         3000
